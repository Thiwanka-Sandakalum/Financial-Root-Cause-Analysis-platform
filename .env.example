# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

# Gemini
# Option A: Gemini API key mode
GEMINI_USE_VERTEXAI=false
GEMINI_API_KEY=replace_me

# Option B: Vertex AI mode (set GEMINI_USE_VERTEXAI=true)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_STRONG_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
EMBEDDING_DIMENSIONS=768
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=200
INGESTION_MIN_CHUNK_LENGTH=100
INGESTION_WRITE_BATCH_SIZE=100
INGESTION_EMBEDDING_BATCH_SIZE=32
INGESTION_EXTRACTION_BATCH_SIZE=16
INGESTION_EXTRACTION_MAX_CONCURRENCY=4
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
SIMILARITY_THRESHOLD=0.8
SUPPORTED_UPLOAD_TYPES=.pdf,.txt
